# ============================================================
# VARIÁVEIS DE AMBIENTE — copie este arquivo para .env
# e preencha com suas credenciais reais.
#
# cp .env.example .env  (Linux/macOS)
# Copy-Item .env.example .env  (Windows PowerShell)
# ============================================================

# URL de conexão com o banco de dados PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/estoque_db?schema=public"

# Chave usada pelo NextAuth para assinar a sessão (JWT).
# Gere uma aleatória:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="troque_por_uma_chave_longa_e_aleatoria"

# URL pública da aplicação (necessária em produção)
NEXTAUTH_URL="http://localhost:3000"
