generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  quantity        Int
  category        String
  validationDate  DateTime?
  unitMeasure     String?
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}